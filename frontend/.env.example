# Frontend environment variables
# Copy this to .env and fill in values.
# These are exposed to the browser via VITE_* prefix.
# Only put public-safe configuration here (no secrets!)

# Google OAuth Client ID (public — safe for browser)
# Get from: https://console.cloud.google.com/apis/credentials
# In Google Cloud Console, set these as Authorized JavaScript Origins:
#   http://localhost:5173
#   http://localhost:5174
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
