# ================================================
# Voyara - Environment Configuration Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ================================================

# --- Spring ---
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080

# --- JWT ---
# Generate: openssl rand -base64 32
# MUST be at least 32 bytes / 256 bits
JWT_SECRET=YOUR_JWT_SECRET_HERE

# --- PostgreSQL (Local / Docker Compose) ---
POSTGRES_DB=travel_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE

# --- PostgreSQL (Production / Railway) ---
# Automatically provided by Railway's PostgreSQL service:
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# --- Redis ---
REDIS_PASSWORD=YOUR_REDIS_PASSWORD_HERE

# --- Razorpay ---
# Get from: https://dashboard.razorpay.com/app/keys
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET_HERE
RAZORPAY_TEST_MODE=true

# --- Gmail SMTP Email ---
# Get from: https://myaccount.google.com/apppasswords
# You need a Gmail account + an App Password (not your regular password)
EMAIL_PROVIDER=gmail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_GMAIL_ADDRESS_HERE
MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD_HERE
MAIL_FROM=YOUR_GMAIL_ADDRESS_HERE
MAIL_FROM_NAME=Voyara

# --- Google OAuth ---
# Get from: https://console.cloud.google.com/apis/credentials
# IMPORTANT: Add http://localhost:5173 and http://localhost:5174
# as Authorized JavaScript Origins in Google Cloud Console
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE

# --- Mobile OTP - Message Central VerifyNow ---
# Get from: https://console.messagecentral.com
# Sign up, get customerId and password
MESSAGECENTRAL_ENABLED=false
MESSAGECENTRAL_CUSTOMER_ID=YOUR_CUSTOMER_ID_HERE
MESSAGECENTRAL_EMAIL=YOUR_EMAIL_HERE
MESSAGECENTRAL_PASSWORD=YOUR_PASSWORD_HERE


# --- OTP Security ---
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
OTP_MAX_PER_HOUR=5
OTP_LOCK_DURATION=900

# --- Frontend ---
FRONTEND_BASE_URL=http://localhost:5173
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,https://*.vercel.app

# --- Logging ---
LOG_LEVEL=INFO
LOG_LEVEL_SECURITY=WARN

# --- Swagger (dev only) ---
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true

# --- Development Mock Seed Data ---
# Set to true for rich development/testing mock dataset; false in production environments
SEED_DATA_ENABLED=true
